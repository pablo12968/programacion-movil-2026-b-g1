{
  "name": "unieventos-semana09",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "concurrently -k -n API,APP \"npm:dev:api\" \"npm:dev:app\"",
    "dev:api": "node --watch api/server.js",
    "dev:app": "vite --host 127.0.0.1",
    "start": "node api/server.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test api/tests/*.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ionic/react": "8.4.3",
    "@ionic/react-router": "8.4.3",
    "express": "^4.21.2",
    "ionicons": "^7.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.4.1"
  }
}
